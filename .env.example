# Export these in your shell; the CLI does not automatically load .env files.
PAGEVOICE_DATA=.
# Optional Python power mode only. The static web app reads none of these variables.
# Python Edge narration requires internet and explicit --allow-network consent.
# Parsing, analysis, project storage and assembly run locally.

# Local server port; use another port if this one is occupied.
PAGEVOICE_PORT=8765

# Deployment. Default remains local; Docker binds 0.0.0.0 internally only.
PAGEVOICE_HOST=127.0.0.1
PAGEVOICE_HOSTED=0
# Legacy shared-token hosted mode. Do not use for a public library.
PAGEVOICE_ACCESS_TOKEN=
# Compose sets PocketBase guest mode for its worker. Set these only when
# running a hosted worker without Compose; keep local CLI mode unchanged.
# PAGEVOICE_AUTH_MODE=pocketbase
# PAGEVOICE_POCKETBASE_URL=http://pocketbase:8090
# PAGEVOICE_POCKETBASE_AUTH_COLLECTION=guests
PAGEVOICE_MEDIA_SECRET=
PAGEVOICE_USER_QUOTA_MB=2048
# Set to the exact Vercel frontend origin for PocketBase's browser CORS policy.
PB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAGEVOICE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Exact comma-separated origins. To use the Vercel frontend with this local API,
# add its stable origin, e.g. https://pagevoice.example.com (no trailing slash).
PAGEVOICE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated exact reverse-proxy IPs/CIDRs; empty means no forwarded-header trust.
PAGEVOICE_TRUSTED_PROXIES=
PAGEVOICE_DISK_QUOTA_MB=10240
# Requests per IP per minute (hosted mode only).
PAGEVOICE_RATE_LIMIT=600
# Historical frontend variables. Current static web/ ignores these; leave unset.
VITE_API_BASE_URL=
VITE_POCKETBASE_URL=

# Optional explicitly installed local semantic model; default mode stays lexical.
# PAGEVOICE_RAG_MODEL_DIR=/absolute/path/to/models/multilingual-minilm
